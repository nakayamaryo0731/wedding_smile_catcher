rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Check if user is an admin (operator)
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/accounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.is_admin == true;
    }

    // Helper: Check if user owns the event
    function isEventOwner(eventId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.account_id == request.auth.uid;
    }

    function isStringOfSize(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    // Helper: Validate an application form submission
    // Must stay in sync with getFormData() in src/frontend/js/apply.js and the limits in apply.html
    function isValidApplication(data) {
      let fields = ['groom_name', 'bride_name', 'email', 'event_date', 'start_time', 'end_time',
        'guest_count', 'venue_name', 'referral_source', 'questions', 'status', 'event_id', 'created_at'];
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields)
        && isStringOfSize(data.groom_name, 1, 50)
        && isStringOfSize(data.bride_name, 1, 50)
        && isStringOfSize(data.email, 3, 254) && data.email.matches('^[^@]+@[^@]+$')
        && data.event_date is string && data.event_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.start_time is string && data.start_time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.end_time is string && data.end_time.matches('^[0-9]{2}:[0-9]{2}$')
        && data.guest_count in ['~50人', '51~100人', '101~150人', '150人~']
        && isStringOfSize(data.venue_name, 0, 100)
        && data.referral_source in ['', 'ネット検索', '友人の紹介', 'SNS', '過去に参加した', 'その他']
        && isStringOfSize(data.questions, 0, 1000)
        && data.status == 'pending'
        && data.event_id == null
        && data.created_at == request.time;
    }

    // Accounts collection
    // Admins can read all; regular users can only read their own
    // Users can create their own account with the sign-up fields only (never is_admin),
    // and afterwards change only display_name; everything else is admin-only
    match /accounts/{accountId} {
      allow read: if request.auth != null && (isAdmin() || request.auth.uid == accountId);
      allow create: if request.auth != null && request.auth.uid == accountId
        && request.resource.data.keys().hasOnly(['email', 'display_name', 'created_at', 'terms_accepted_at', 'status']);
      allow update: if request.auth != null
        && (isAdmin()
          || (request.auth.uid == accountId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name'])));
      allow delete: if false;
    }

    // Events collection
    // Public get (single doc) for ranking UI status check
    // Only admins can list and create (events are created from the admin panel)
    // Update/delete requires ownership or admin
    // Theme and event_name can be updated by anyone (for ranking page settings)
    match /events/{eventId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.account_id == request.auth.uid;
      allow update: if (request.auth != null
        && (isAdmin() || resource.data.account_id == request.auth.uid))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme', 'event_name'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['event_name'])
            || (request.resource.data.event_name is string
              && request.resource.data.event_name.size() >= 1
              && request.resource.data.event_name.size() <= 100)));
      allow delete: if request.auth != null
        && (isAdmin() || resource.data.account_id == request.auth.uid);
    }

    // Users collection (LINE users, not Firebase users)
    // Public read for ranking display
    // Admins can write; event owners can update (for soft delete)
    match /users/{userId} {
      allow read: if true;
      allow create: if false;
      allow update: if request.auth != null &&
        (isAdmin() || isEventOwner(resource.data.event_id));
      allow delete: if request.auth != null && isAdmin();
    }

    // Images collection
    // Public read for ranking display
    // Admins can write; event owners can update (for soft delete)
    // Unauthenticated users can only set deleted_at (for ranking page soft delete)
    match /images/{imageId} {
      allow read: if true;
      allow create: if false;
      allow update: if (request.auth != null &&
        (isAdmin() || isEventOwner(resource.data.event_id)))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted_at']);
      allow delete: if request.auth != null && isAdmin();
    }

    // Applications collection (application form submissions)
    // Public create for form submission (no auth required), limited to auto-generated IDs and the form's fields
    // Admins can read/update (for reviewing and creating events)
    match /applications/{applicationId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if applicationId.matches('^[A-Za-z0-9]{20}$')
        && isValidApplication(request.resource.data);
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }
  }
}
